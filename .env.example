# mock | api
VITE_DATA_SOURCE=mock

# Used when VITE_DATA_SOURCE=api
VITE_API_BASE_URL=http://localhost:3000/api

# Raster tile source (.png)
# VITE_RASTER_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Optional vector tile source (.pbf). Example local tile server:
# VITE_VECTOR_TILE_URL=http://localhost:8080/tiles/{z}/{x}/{y}.pbf
VITE_VECTOR_TILE_URL=https://tiles.versatiles.org/tiles/osm/{z}/{x}/{y}